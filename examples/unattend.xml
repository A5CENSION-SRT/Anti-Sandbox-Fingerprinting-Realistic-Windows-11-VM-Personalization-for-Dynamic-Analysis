<?xml version="1.0" encoding="utf-8"?>
<!--
  unattend.xml - Windows 11 Unattended Installation Template for ARC
  
  This file automates Windows 11 installation for creating baseline VHDX images.
  It performs the following:
  
  1. WindowsPE Pass: Disk partitioning and Windows installation
  2. Specialize Pass: Computer name and network configuration
  3. OOBE System Pass: Skip OOBE, create local user, run initialization
  
  Key Features:
  - Fully automated installation (no user interaction)
  - Skips Windows 11 TPM/Secure Boot checks
  - Creates local admin user "ArcUser"
  - Waits 180 seconds for system initialization
  - Shuts down automatically after OOBE
  
  Usage:
    virt-install --initrd-inject unattend.xml ...
  
  Requirements:
  - Windows 11 ISO (22H2 or later)
  - UEFI boot mode
  - Minimum 64 GB disk
  
  Post-Installation State:
  - $UsnJrnl initialized
  - Prefetch enabled and populated
  - Event logs (System, Application, Security) initialized
  - Registry hives with .LOG files
  - Windows Update baseline artifacts
  
  Security Note:
  This template creates a user with a blank password for lab use only.
  Do NOT use this configuration for production systems.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  
  <!-- ================================================================== -->
  <!-- Pass 1: WindowsPE - Disk Configuration and Installation           -->
  <!-- ================================================================== -->
  <settings pass="windowsPE">
    
    <!-- International Settings -->
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    
    <!-- Windows Setup Configuration -->
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      
      <!-- Disk Configuration -->
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            
            <!-- EFI System Partition (ESP) -->
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>100</Size>
            </CreatePartition>
            
            <!-- Microsoft Reserved Partition (MSR) -->
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>16</Size>
            </CreatePartition>
            
            <!-- Windows System Partition (C:) -->
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
            
          </CreatePartitions>
          
          <ModifyPartitions>
            
            <!-- Format ESP -->
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Label>System</Label>
              <Format>FAT32</Format>
            </ModifyPartition>
            
            <!-- MSR (no format needed) -->
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            
            <!-- Format Windows partition -->
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Label>Windows</Label>
              <Letter>C</Letter>
              <Format>NTFS</Format>
            </ModifyPartition>
            
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
      
      <!-- Image Selection -->
      <ImageInstall>
        <OSImage>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <InstallToAvailablePartition>false</InstallToAvailablePartition>
          <!-- Install Windows 11 Pro -->
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/INDEX</Key>
              <Value>6</Value>
            </MetaData>
          </InstallFrom>
        </OSImage>
      </ImageInstall>
      
      <!-- Product Key (Generic Windows 11 Pro key for installation) -->
      <UserData>
        <ProductKey>
          <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
        <AcceptEula>true</AcceptEula>
      </UserData>
      
      <!-- Skip Windows 11 Hardware Checks -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
      
    </component>
    
  </settings>
  
  <!-- ================================================================== -->
  <!-- Pass 2: Specialize - System Configuration                         -->
  <!-- ================================================================== -->
  <settings pass="specialize">
    
    <!-- Computer Name -->
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ComputerName>ARC-BASELINE</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
    
    <!-- Network Configuration -->
    <component name="Microsoft-Windows-TCPIP" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <Interfaces>
        <Interface wcm:action="add">
          <Identifier>Ethernet</Identifier>
          <Ipv4Settings>
            <DhcpEnabled>true</DhcpEnabled>
          </Ipv4Settings>
        </Interface>
      </Interfaces>
    </component>
    
  </settings>
  
  <!-- ================================================================== -->
  <!-- Pass 3: OOBE System - User Creation and First Boot                -->
  <!-- ================================================================== -->
  <settings pass="oobeSystem">
    
    <!-- Shell Setup -->
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      
      <!-- OOBE Configuration -->
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipUserOOBE>true</SkipUserOOBE>
        <SkipMachineOOBE>true</SkipMachineOOBE>
      </OOBE>
      
      <!-- User Accounts -->
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>ArcUser</Name>
            <DisplayName>ARC User</DisplayName>
            <Group>Administrators</Group>
            <Password>
              <Value></Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      
      <!-- Auto Logon (for first boot initialization) -->
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>ArcUser</Username>
        <Password>
          <Value></Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>1</LogonCount>
      </AutoLogon>
      
      <!-- First Logon Commands -->
      <FirstLogonCommands>
        
        <!-- Wait for system initialization (180 seconds) -->
        <!-- This allows Windows to:
             - Initialize $UsnJrnl
             - Create initial Prefetch files
             - Populate event logs
             - Complete Windows Update checks
             - Initialize Windows Defender
        -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>cmd /c timeout /t 180 /nobreak</CommandLine>
          <Description>Wait for system initialization</Description>
        </SynchronousCommand>
        
        <!-- Enable Prefetch (ensure it's enabled) -->
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnablePrefetcher /t REG_DWORD /d 3 /f</CommandLine>
          <Description>Enable Prefetch</Description>
        </SynchronousCommand>
        
        <!-- Enable SuperFetch -->
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnableSuperfetch /t REG_DWORD /d 3 /f</CommandLine>
          <Description>Enable SuperFetch</Description>
        </SynchronousCommand>
        
        <!-- Disable Windows Update (to prevent modifications after baseline) -->
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU" /v NoAutoUpdate /t REG_DWORD /d 1 /f</CommandLine>
          <Description>Disable Windows Update</Description>
        </SynchronousCommand>
        
        <!-- Disable Windows Defender (to prevent modifications after baseline) -->
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v DisableAntiSpyware /t REG_DWORD /d 1 /f</CommandLine>
          <Description>Disable Windows Defender</Description>
        </SynchronousCommand>
        
        <!-- Shutdown after initialization -->
        <SynchronousCommand wcm:action="add">
          <Order>6</Order>
          <CommandLine>shutdown /s /t 10 /c "Baseline initialization complete"</CommandLine>
          <Description>Shutdown system</Description>
        </SynchronousCommand>
        
      </FirstLogonCommands>
      
    </component>
    
  </settings>
  
</unattend>
